# Modèle de configuration de PRODUCTION (cPanel).
# À copier dans ~/top-gest/.env sur le serveur, puis compléter. Ne jamais versionner le .env réel.

APP_NAME=MyGest
APP_ENV=production
# Générer en local : php artisan key:generate --show   (puis coller la valeur ici)
APP_KEY=
APP_DEBUG=false
APP_URL=https://votre-domaine.cg

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# Base MySQL créée dans cPanel (« Bases de données MySQL ») : noms préfixés par l'utilisateur cPanel.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_mygest
DB_USERNAME=cpaneluser_mygest
DB_PASSWORD=

# Sessions en base, chiffrées, cookie réservé au HTTPS.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Aucune tâche n'est mise en file d'attente : pas de worker nécessaire sur le mutualisé.
QUEUE_CONNECTION=sync
# Base de données : nécessaire pour le verrou anti double-certification SFEC.
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@votre-domaine.cg"
MAIL_FROM_NAME="${APP_NAME}"

# SFEC — production : https://api.sfec.gouv.cg (factures à valeur fiscale).
# Pendant la phase de tests, utiliser l'environnement de test fourni par le SFEC.
SFEC_BASE_URL=https://api.sfec.gouv.cg
SFEC_API_KEY=
SFEC_SCIET=

# Comptes créés au premier « php artisan db:seed --force » (mot de passe aléatoire affiché une fois).
SEED_ADMIN_EMAIL=admin@votre-domaine.cg
SEED_DG_EMAIL=dg@votre-domaine.cg
